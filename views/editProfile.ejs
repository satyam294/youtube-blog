<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Edit Profile - <%= user.fullName %></title>
</head>
<body>
  <%- include('./partials/navbar') %>

  <main class="container py-4 py-md-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
          <div>
            <h1 class="h2 fw-bold mb-1">Edit Profile</h1>
            <p class="text-muted mb-0">Update your profile information.</p>
          </div>
          <a href="/user/profile" class="btn btn-outline-secondary align-self-start align-self-sm-auto">View Profile</a>
        </div>

        <form action="/user/edit" method="POST" enctype="multipart/form-data">
          <div class="card border-0 shadow">
            <div class="card-body p-3 p-sm-4 p-md-5">
              <div class="d-flex flex-column gap-4">
                <section>
                  <div class="row align-items-center g-3">
                    <div class="col-4 col-sm-3">
                      <div class="ratio ratio-1x1">
                        <img
                          src="<%= user.profileImageURL || '/images/default-profile.png' %>"
                          alt="<%= user.fullName %>"
                          class="object-fit-cover rounded-circle border"
                        >
                      </div>
                    </div>
                    <div class="col-12 col-sm-9">
                      <label for="profileImage" class="form-label">Profile picture</label>
                      <input class="form-control" type="file" id="profileImage" name="profileImage" accept="image/png,image/jpeg,image/webp">
                      <div class="form-text">Choose a new profile picture. PNG, JPEG, or WebP; maximum 5 MB.</div>
                    </div>
                  </div>
                </section>

                <hr class="my-0">

                <section>
                  <div>
                    <label for="fullName" class="form-label">Full name</label>
                    <input class="form-control" type="text" id="fullName" name="fullName" value="<%= user.fullName %>" autocomplete="name" required>
                  </div>
                </section>

                <hr class="my-0">

                <section>
                  <div>
                    <label for="email" class="form-label">Email address</label>
                    <input class="form-control" type="email" id="email" name="email" value="<%= user.email %>" autocomplete="email" required>
                  </div>
                </section>

                <hr class="my-0">

                <section>
                  <div>
                    <label for="bio" class="form-label">Bio</label>
                    <textarea class="form-control" id="bio" name="bio" rows="4" maxlength="300"><%= user.bio || '' %></textarea>
                    <div class="form-text">Maximum 300 characters.</div>
                  </div>
                </section>
              </div>
            </div>

            <div class="card-footer bg-body-tertiary border-0 p-3 p-sm-4 d-flex flex-column flex-sm-row justify-content-end gap-2">
              <a href="/user/profile" class="btn btn-outline-secondary order-2 order-sm-1">Cancel</a>
              <button type="submit" class="btn btn-primary order-1 order-sm-2">Save changes</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('./partials/script') %>
</body>
</html>
