<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Profile - <%= user.fullName %></title>
</head>
<body>
  <%- include('./partials/navbar') %>

  <div class="container py-5">

    <!-- Incomplete Profile Tip -->
    <% if (!user.profileComplete) { %>
      <div class="alert alert-info d-flex align-items-center justify-content-between mb-4" role="alert">
        <div>
          <h6 class="alert-heading mb-1">
            <i class="bi bi-person-exclamation me-2"></i>
            Complete your profile
          </h6>
          <p class="mb-0">
            Add a profile picture and bio to make your profile more personal.
          </p>
        </div>

        <!-- Dummy edit option for now -->
        <button class="btn btn-primary btn-sm ms-3">
          Complete Profile
        </button>
      </div>
    <% } %>


    <!-- Profile Card -->
    <div class="card border-0 shadow mb-5">
      <div class="card-body p-4 p-md-5">

        <div class="row align-items-center">

          <!-- Profile Picture -->
          <div class="col-md-3 text-center mb-4 mb-md-0">
            <img
              src="<%= user.profileImageURL || '/images/default-profile.png' %>"
              alt="<%= user.fullName %>"
              class="rounded-circle img-fluid border"
              style="width: 160px; height: 160px; object-fit: cover;"
            >
          </div>

          <!-- Profile Information -->
          <div class="col-md-9">

            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h2 class="fw-bold mb-2">
                  <%= user.fullName %>
                </h2>

                <p class="text-muted mb-3">
                  <%= user.bio || 'No bio added yet.' %>
                </p>
              </div>

              <!-- Dummy Edit Button -->
              <button class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Profile
              </button>
            </div>

          </div>

        </div>

      </div>
    </div>


    <!-- My Blogs -->
    <div>
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h3 class="fw-bold mb-1">My Blogs</h3>
          <p class="text-muted mb-0">
            Blogs you've written
          </p>
        </div>

        <!-- Dummy button -->
        <button class="btn btn-primary">
          <i class="bi bi-plus-lg me-1"></i>
          Create Blog
        </button>
      </div>


      <!-- Dummy Blog Cards -->
      <div class="row g-4">

        <!-- Blog 1 -->
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h5 class="card-title fw-semibold">
                Getting Started with Node.js
              </h5>

              <p class="card-text text-muted">
                A beginner-friendly introduction to building web applications
                with Node.js and Express.
              </p>

              <small class="text-muted">
                Published recently
              </small>
            </div>

            <div class="card-footer bg-white border-0">
              <button class="btn btn-outline-primary btn-sm">
                Read Blog
              </button>
            </div>
          </div>
        </div>


        <!-- Blog 2 -->
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h5 class="card-title fw-semibold">
                Understanding MongoDB
              </h5>

              <p class="card-text text-muted">
                Exploring the fundamentals of MongoDB and how it works with
                Express applications.
              </p>

              <small class="text-muted">
                Published recently
              </small>
            </div>

            <div class="card-footer bg-white border-0">
              <button class="btn btn-outline-primary btn-sm">
                Read Blog
              </button>
            </div>
          </div>
        </div>


        <!-- Blog 3 -->
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h5 class="card-title fw-semibold">
                Building My First Blog App
              </h5>

              <p class="card-text text-muted">
                What I learned while building a complete blog application
                using Express and EJS.
              </p>

              <small class="text-muted">
                Published recently
              </small>
            </div>

            <div class="card-footer bg-white border-0">
              <button class="btn btn-outline-primary btn-sm">
                Read Blog
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
  <%- include('./partials/script') %>
</body>
</html>